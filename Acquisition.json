        -480,
        144
      ],
      "id": "9a9dbcae-a217-4dba-b9b2-011e9796270f",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "url": "=[your_key]=*",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "[your_key]"
            },
            {
              "name": "apikey",
              "value": "[your_key]"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
